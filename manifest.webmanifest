{
  "name": "JustAPlaylist",
  "short_name": "JustAPlaylist",
  "description": "Turns the songs posted in a WhatsApp group into a Spotify playlist.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF1EF",
  "theme_color": "#EEF1EF",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "chat",
          "accept": ["text/plain", "text/*", "application/zip", "application/x-zip-compressed", ".txt", ".zip"]
        }
      ]
    }
  }
}
